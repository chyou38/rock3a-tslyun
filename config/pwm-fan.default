# /etc/default/pwm-fan  (ROCK 3A 风扇; BSP 走 pwm-fan hwmon, 旧 mainline 走 pwm8)
# 模式: auto=温度曲线 / manual=固定占空比 (网页「风扇设置」可改, 立即生效)
FAN_MODE=auto
FAN_MANUAL_DUTY=50

# 曲线按温度升序 (单位: 千分之一摄氏度; 低于第一点停转, 高于最后点全速)
FAN_CURVE="45000:0 50000:35 60000:55 70000:80 75000:100"

# 启停回差 (千分之一摄氏度), 防止在启动温度附近频繁启停
FAN_HYST=3000

# PWM 周期 ns (40000 = 25kHz, 风扇标准频率)
FAN_PERIOD=40000

# 轮询间隔秒
FAN_POLL=10
